theme = dark:Aura,light:CLRS
font-size = 11 
window-decoration =true 
# keybind = global:cmd+/=toggle_quick_terminal
background-opacity = 0.8
background-blur-radius = 1

#font-family = "MesloLGS NF"
command = tmux new-session -A
shell-integration = zsh

cursor-style =block
cursor-style-blink = true
window-padding-x = 0

# Keybindings
# keybind = ctrl+shift+8=new_split:right
# keybind = ctrl+shift+9=new_split:down
#
# keybind = ctrl+alt+h=goto_split:left
# keybind = ctrl+alt+j=goto_split:down
# keybind = ctrl+alt+k=goto_split:up
# keybind = ctrl+alt+l=goto_split:right

# Reload config
keybind = ctrl+shift+r=reload_config
window-inherit-working-directory = true
